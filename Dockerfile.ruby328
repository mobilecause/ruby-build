FROM amazonlinux:latest

# Update system and install development tools including latest OpenSSL
RUN dnf update -y && \
    dnf groupinstall -y "Development Tools" && \
    dnf install -y --allowerasing \
        rpm-build \
        rpm-devel \
        rpmdevtools \
        wget \
        perl \
        readline-devel \
        libffi-devel \
        libyaml-devel \
        zlib-devel \
        gdbm-devel \
        ncurses-devel \
        tk-devel \
        sqlite-devel \
        pcre-devel \
        libxml2-devel \
        libxslt-devel \
        expat-devel \
        libdb-devel \
        cmake \
        gmp-devel \
        hostname \
        systemtap \
        procps-ng \
        'dnf-command(builddep)' \
        dnf-plugins-core \
        openssl-devel \
        openssl

# Create build user and setup RPM build environment
RUN useradd -m builder && \
    su - builder -c "rpmdev-setuptree"

# Switch to builder user
USER builder
WORKDIR /home/builder

# Copy Ruby 3.2.8 spec files and patches from 328 folder
COPY 328/ rpmbuild/SOURCES/

# Move ruby.spec to SPECS directory
USER root
RUN cd /home/builder && \
    if [ -f rpmbuild/SOURCES/ruby.spec ]; then \
        mv rpmbuild/SOURCES/ruby.spec rpmbuild/SPECS/; \
    fi && \
    chown -R builder:builder rpmbuild/

# Download Ruby 3.2.8 source tarball based on spec file
USER builder
RUN cd /home/builder && \
    spectool -g -R rpmbuild/SPECS/ruby.spec

# Install additional build dependencies including Rust and create missing tools
USER root
RUN dnf install -y --allowerasing checksec multilib-rpm-config rust cargo || true

# Install Ruby build dependencies
RUN cd /home/builder && \
    dnf builddep -y rpmbuild/SPECS/ruby.spec || \
    (grep "BuildRequires:" rpmbuild/SPECS/ruby.spec | sed 's/BuildRequires://g' | sed 's/,/ /g' | xargs dnf install -y --allowerasing || true)

# Build Ruby 3.2.8 RPM with latest OpenSSL
USER builder
RUN echo "=== Building Ruby 3.2.8 with latest OpenSSL ===" && \
    rpmbuild -bb rpmbuild/SPECS/ruby.spec

# Create unified output directory with all RPMs
RUN echo "=== Creating unified output directory ===" && \
    mkdir -p /home/builder/output && \
    echo "=== Copying all built RPMs to output directory ===" && \
    find rpmbuild/RPMS -name "*.rpm" -exec cp {} /home/builder/output/ \; && \
    echo "=== Final RPM inventory ===" && \
    ls -la /home/builder/output/ && \
    echo "=== RPM details ===" && \
    for rpm in /home/builder/output/*.rpm; do \
        echo "=== $(basename $rpm) ==="; \
        rpm -qp --info "$rpm" 2>/dev/null || echo "Could not read RPM info"; \
        echo ""; \
    done

# Test RPM installation with latest OpenSSL
USER root
RUN echo "=== Testing RPM installation ===" && \
    dnf remove -y ruby* rubygems* --skip-broken || true && \
    dnf clean all && \
    echo "=== Installing Ruby 3.2.8 packages ===" && \
    rpm -ivh --force --nodeps /home/builder/output/ruby-libs-*.rpm && \
    rpm -ivh --force --nodeps /home/builder/output/ruby-3.2*.rpm && \
    echo "=== Testing Ruby binary location ===" && \
    ls -la /usr/bin/ruby* && \
    echo "=== Testing Ruby functionality ===" && \
    ruby --version && \
    echo "=== All tests passed! ==="

# Create complete ruby3-2-8 repository structure
USER builder
RUN echo "=== Creating ruby3-2-8 repository structure ===" && \
    mkdir -p /home/builder/ruby3-2-8/rpm-repo/x86_64 && \
    mkdir -p /home/builder/ruby3-2-8/client-setup && \
    echo "=== Copying x86_64 and noarch RPM packages ===" && \
    find /home/builder/output -name '*x86_64.rpm' -exec cp {} /home/builder/ruby3-2-8/rpm-repo/x86_64/ \; 2>/dev/null || true && \
    find /home/builder/output -name '*noarch.rpm' -exec cp {} /home/builder/ruby3-2-8/rpm-repo/x86_64/ \; 2>/dev/null || true

# Switch to root to install createrepo_c
USER root
RUN echo "=== Installing createrepo_c ===" && \
    dnf install -y createrepo_c

# Switch back to builder and continue repository creation
USER builder
RUN echo "=== Generating repository metadata ===" && \
    createrepo_c /home/builder/ruby3-2-8/rpm-repo/x86_64/ && \
    echo "=== Creating client setup files ===" && \
    echo '[ruby-build-3-2-8]' > /home/builder/ruby3-2-8/client-setup/ruby-build.repo && \
    echo 'name=Ruby 3.2.8 Build Repository' >> /home/builder/ruby3-2-8/client-setup/ruby-build.repo && \
    echo 'baseurl=https://raw.githubusercontent.com/mobilecause/ruby-build/main/ruby3-2-8/rpm-repo/x86_64/' >> /home/builder/ruby3-2-8/client-setup/ruby-build.repo && \
    echo 'enabled=1' >> /home/builder/ruby3-2-8/client-setup/ruby-build.repo && \
    echo 'gpgcheck=0' >> /home/builder/ruby3-2-8/client-setup/ruby-build.repo && \
    echo 'metadata_expire=300' >> /home/builder/ruby3-2-8/client-setup/ruby-build.repo && \
    echo 'priority=9' >> /home/builder/ruby3-2-8/client-setup/ruby-build.repo && \
    echo "=== Creating installation script ===" && \
    echo '#!/bin/bash' > /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo 'set -e' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo '' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo 'REPO_URL="https://raw.githubusercontent.com/mobilecause/ruby-build/main"' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo '' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo 'echo "Installing Ruby 3.2.8 repository..."' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo '' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo '# Download repo config with priority=9' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo 'curl -fsSL "$REPO_URL/ruby3-2-8/client-setup/ruby-build.repo" \\' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo '    -o "/etc/yum.repos.d/ruby-build-3-2-8.repo"' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo '' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo '# Refresh cache' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo 'dnf clean all' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo 'dnf makecache' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo '' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo 'echo "✅ Ruby 3.2.8 repository installed with priority 9!"' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo 'echo "📦 Install Ruby: dnf install ruby"' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo 'echo "🔍 Verify source: dnf info ruby"' >> /home/builder/ruby3-2-8/client-setup/install.sh && \
    chmod +x /home/builder/ruby3-2-8/client-setup/install.sh && \
    echo "=== Complete ruby3-2-8 structure ===" && \
    find /home/builder/ruby3-2-8 -type f | sort && \
    echo "=== Repository metadata verification ===" && \
    ls -la /home/builder/ruby3-2-8/rpm-repo/x86_64/repodata/ && \
    echo "=== Client setup files ===" && \
    ls -la /home/builder/ruby3-2-8/client-setup/

CMD ["/bin/bash"]